@@ -969,6 +991,54 @@
 # cc_binary instead of cc_shared_library since the latter expects you to
 # re-export all transitive dependencies vs them being relinked into other
 # binaries.
+#
+# On Windows the target is named with an explicit ".dll": a linkshared
+# cc_binary whose name has no extension makes Bazel synthesize the DLL
+# artifact itself, and that synthesized output collides with the path
+# cc_import materializes for the same library ("generated by these
+# conflicting actions"). Linking against a DLL also goes through its import
+# library, which the link emits as the "interface_library" output group;
+# Bazel does not emit an import library for a linkshared cc_binary (the
+# interface_library_output_path variable arrives as the literal "ignored"),
+# so the wrapper below stays a runtime-only import on Windows; link-time
+# consumers need a separately generated import library.
+cc_binary(
+    name = "dll/lldb{}.dll".format(PACKAGE_VERSION),
+    additional_linker_inputs = select({
+        "@platforms//os:linux": [
+            ":gen_exports_file_linux",
+        ],
+        "@platforms//os:macos": [
+            ":gen_exports_file_macos",
+        ],
+        "//conditions:default": [],
+    }),
+    linkopts = select({
+        "@platforms//os:linux": [
+            "-Wl,--export-dynamic-symbol-list=$(location :gen_exports_file_linux)",
+        ],
+        "@platforms//os:macos": [
+            "-Wl,-exported_symbols_list,$(location :gen_exports_file_macos)",
+        ],
+        # CMake appends psapi under WIN32, and the UUID helpers in the
+        # Windows host layer need the RPC runtime; the transitive
+        # llvm:Support linkopts carry neither.
+        "@platforms//os:windows": [
+            "-lpsapi",
+            "-lrpcrt4",
+            # MiniDumpWriteDump, used by the Windows process plugin.
+            "-ldbghelp",
+        ],
+        "//conditions:default": [],
+    }),
+    linkshared = True,
+    deps = [
+        ":API",
+        ":Interpreter",
+    ],
+    target_compatible_with = ["@platforms//os:windows"],
+)
+
