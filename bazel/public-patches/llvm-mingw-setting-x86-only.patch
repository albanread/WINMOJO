diff --git a/utils/bazel/llvm-project-overlay/llvm/BUILD.bazel b/utils/bazel/llvm-project-overlay/llvm/BUILD.bazel
index 2b5a70b..da0514d 100644
--- a/utils/bazel/llvm-project-overlay/llvm/BUILD.bazel
+++ b/utils/bazel/llvm-project-overlay/llvm/BUILD.bazel
@@ -305,9 +305,23 @@ write_file(
     ],
 )
 
+# Constrained to x86_64 for this fork. Upstream treats "Windows plus a compiler
+# of clang" as MinGW, but that is exactly what a clang driver targeting the MSVC
+# ABI also reports, so on Windows ARM64 this matched and the link picked up
+# MinGW flags: -Wl,--stack,16777216 in GNU syntax, and -lole32 style libraries
+# that lld-link then looked for as ole32.lib. Because this setting names both
+# the OS and the compiler it is more specialized than is_windows_msvc, so it won
+# the select outright.
+#
+# MinGW does not meaningfully target ARM64 Windows, so restricting this to
+# x86_64 leaves upstream behaviour intact for MinGW users while letting the MSVC
+# branch match here.
 config_setting(
     name = "is_windows_clang_mingw",
-    constraint_values = ["@platforms//os:windows"],
+    constraint_values = [
+        "@platforms//cpu:x86_64",
+        "@platforms//os:windows",
+    ],
     flag_values = {"@rules_cc//cc/compiler:compiler": "clang"},
 )
 
