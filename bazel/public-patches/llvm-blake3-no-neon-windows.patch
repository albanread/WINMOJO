@@ -406,6 +406,13 @@ cc_library(
     ],
     copts = llvm_copts,
     defines = select({
+        # Windows ARM64 is aarch64 but cannot use the NEON path: blake3_neon.c
+        # calls __builtin_shufflevector on the results of vreinterpretq_*, and
+        # those resolve to MSVC's __n128 union rather than a clang vector type,
